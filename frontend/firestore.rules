rules_version = '2';

// ─── Badminton Starz — Firestore Security Rules ────────────────────────────────
// Model: the dashboard is PUBLIC read-only; only admins can write.
//
// A user is an admin iff a document exists at  admins/{their-uid}.
// To create the first admin (one-time, in the Firebase console):
//   1. Authentication → Users → Add user (email + password).
//   2. Firestore → collection "admins" → add a doc whose ID is that user's UID.
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Tournaments and their matches: anyone may read; only admins may write.
    match /fixtures/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /matches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin registry. A signed-in user may read ONLY their own admin doc (so the
    // app can learn their role). No client may write — manage admins from the
    // Firebase console or the Admin SDK.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
